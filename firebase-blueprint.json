  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private authenticated user profile documents isolated per owner and Super Admins."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Authoritative Super Admin UID allowlist."
    },
    "/adminInvites/{inviteEmail}": {
      "schema": { "$ref": "#/entities/AdminInvite" },
      "description": "Authorized Super Admin email invites keyed by lowercase email address."
    },
    "/clientAccounts/{clientId}": {
      "schema": { "$ref": "#/entities/ClientAccount" },
      "description": "Master client accounts table storing business profile, tabletop units, billing, and ad network opt-in status."
    },
    "/clientAccounts/{clientId}/promotions/{promoId}": {
      "schema": { "$ref": "#/entities/PromotionRecord" },
      "description": "Client promotions and attract loop slides with copy, durations, and date/time playback schedules."
    },
    "/clientAccounts/{clientId}/menuCategories/{categoryId}": {
      "schema": { "$ref": "#/entities/MenuCategoryRecord" },
      "description": "Client tabletop menu category definitions."
    },
    "/clientAccounts/{clientId}/menuItems/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItemRecord" },
      "description": "Client menu items with prices, categories, dietary notes, images, availability, and house favorite flags."
    },
    "/clientAccounts/{clientId}/specials/{specialId}": {
      "schema": { "$ref": "#/entities/DailySpecialRecord" },
      "description": "Client daily specials with availability windows, special/regular pricing, descriptions, and media."
    },
    "/clientAccounts/{clientId}/mediaAssets/{assetId}": {
      "schema": { "$ref": "#/entities/MediaAssetRecord" },
      "description": "Registry of stored image and video assets attached to a client venue."
    },
    "/clientAccounts/{clientId}/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/DeviceScreenRecord" },
      "description": "Assigned tabletop display screens attached to a client account."
    },
    "/networkAds/{adId}": {
      "schema": { "$ref": "#/entities/AdminNetworkAd" },
      "description": "Super Admin managed sponsored ad creatives distributed to opted-in client displays."
    }
  }
}
